# Supabase
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"

# Static admin gate.
# These are checked on the server and a signed httpOnly cookie is issued.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"
SESSION_SECRET="replace-with-a-long-random-string"

# Discord OAuth (member registration/login)
DISCORD_CLIENT_ID="your-discord-application-client-id"
DISCORD_CLIENT_SECRET="your-discord-application-client-secret"
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/discord/callback"

# Google Sheets archive for POV List submissions (optional — appends are
# skipped with a warning if unset, see lib/googleSheets.js). Service account
# credentials, never a user's own Google login.
GOOGLE_SHEETS_CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID="your-google-sheet-id"
